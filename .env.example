# Copy to .env and fill in. Never commit .env.
# Local dev only — in CI, set these as GitHub Actions secrets.

# --- YouTube ---
# Console: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# --- Naver DataLab (search trends, official) ---
# Console: https://developers.naver.com/apps/
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# --- Naver Search Ad API (real KR monthly search volumes) ---
# Console: https://searchad.naver.com/ → 도구 → API 사용 관리
NAVER_SEARCH_AD_API_KEY=
NAVER_SEARCH_AD_SECRET_KEY=
NAVER_SEARCH_AD_CUSTOMER_ID=

# --- LLM router (via auto_project.llm; fills from first available) ---
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=

# --- Telegram alerts (via auto_project.notify) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Optional overrides ---
DEFAULT_REGION=KR
STATE_DIR=state
